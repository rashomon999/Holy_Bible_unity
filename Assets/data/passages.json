            },
            {
              "i": 2,
              "answer": "con pudor y modestia",
              "punct": ";"
            },
            {
              "i": 3,
              "answer": "no con peinado ostentoso",
              "punct": ","
            },
            {
              "i": 4,
              "answer": "ni oro",
              "punct": ","
            },
            {
              "i": 5,
              "answer": "ni perlas",
