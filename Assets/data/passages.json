          "segments": [
            {
              "i": 1,
              "answer": "likewise also that women should adorn themselves in respectable apparel",
              "punct": ","
            },
            {
              "i": 2,
              "answer": "with modesty and self-control",
              "punct": ","
            },
            {
              "i": 3,
              "answer": "not with braided hair and gold or pearls or costly attire",
              "punct": ","
            },
            {
              "i": 4,
              "answer": "but with what is proper for women who profess godliness",
              "punct": "—"
            },
            {
              "i": 5,
              "answer": "with good works",
              "punct": "."
            },
            {
              "i": 6,
              "answer": "Let a woman learn quietly with all submissiveness",
              "punct": "."
            },
            {
              "i": 7,
              "answer": "I do not permit a woman to teach or to exercise authority over a man",
              "punct": ";"
            },
            {
              "i": 8,
              "answer": "rather",
              "punct": ","
            },
            {
              "i": 9,
              "answer": "she is to remain quiet",
              "punct": "."
            },
            {
              "i": 10,
              "answer": "For Adam was formed first",
              "punct": ","
            },
            {
              "i": 11,
              "answer": "then Eve",
              "punct": "."
            }
          ]
        },
        "ES": {
          "title": "1 Timoteo 2:9-13",
          "segments": [
            {
